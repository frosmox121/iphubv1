# Copiá este archivo a .env y completá los valores (NO subas tu .env a ningún lado)
PORT=3001
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
DEFAULT_SCAN_CIDR=192.168.1.0/24
SMTP_SERVICE=gmail
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion_de_google
SUPPORT_TO=iphuboficial@gmail.com
# IA: las líneas NO deben empezar con "#"
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Pollinations (opcional): la API vieja está deprecada; la nueva es gratis con clave en https://enter.pollinations.ai
# POLLINATIONS_API_KEY=
TOOL_XP_COOLDOWN_SEC=120
GOOGLE_CLIENT_ID=
DISCORD_CLIENT_ID=

# Link directo al IPHub.exe subido en GitHub Releases (botón "Descargar para Windows")
EXE_URL=
# Ruta de la base de datos (en Render con disco persistente: /var/data/iphub-db.json)
# DB_PATH=

# --- Hosting 100% gratis (Render Free) ---
# Correo por API HTTP (Render Free bloquea SMTP). Cuenta gratis en brevo.com:
BREVO_API_KEY=
BREVO_SENDER=tu_correo@gmail.com
# Base de datos persistente gratis (upstash.com -> Redis -> REST API):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
